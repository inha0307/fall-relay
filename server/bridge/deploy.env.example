# Copy to deploy.env (not committed; mode 600) and edit for this server.
# install_server_services.sh reads deploy.env from its own directory (also when building the web), and the
# server and web units load it.

# Server checkout that holds the Python virtual environment (.venv) and the Next.js app (frontend/).
FALLRELAY_SERVER_ROOT=/path/to/repository/server

# Server configuration (cameras, port, database). Relative paths are resolved from this directory.
FALLRELAY_SERVER_CONFIG=server_config.json

# Edge devices that need a reverse SSH tunnel to reach the server (space-separated user@host).
# Leave empty when every device can reach the server directly; then set server_url in each
# device's edge_config.json to http://<server-ip>:<port>.
RPI_TARGETS="<user>@<edge-device-host>"

# SSH private key used for all tunnels (never copied into this directory).
RPI_SSH_KEY=$HOME/.ssh/<edge-key>

# Port each device uses locally to reach the server through its tunnel (edge_config server_url).
RPI_TUNNEL_PORT=15001

# Shared secret between the web application and the server API. Generate with: openssl rand -hex 24
# Both the server unit and the web unit read it from this file.
FALLRELAY_WRITE_TOKEN=

# Server address as the browser sees it (live skeleton stream). Embedded into the web build, so rebuild after changing it.
NEXT_PUBLIC_PIPELINE_URL=http://<server-ip>:5001

# PostgreSQL database of the server and the web application: a libpq connection string with a passfile (required).
FALLRELAY_DATABASE_URL="host=127.0.0.1 port=5432 dbname=fall-relay user=fall-relay passfile=/path/to/.pgpass"

# Schema that holds the web application's accounts and sessions in that database (default: app).
# FALLRELAY_APP_SCHEMA=app
